function UI.slider(page, label, min, max, default, onChange, onRelease, fmt)
    fmt = fmt or "%.1f"
    local val = default
    local paint = nil
    local ok, err = pcall(function()
        local holder = mk("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.fromRGB(30, 30, 38),
            BorderSizePixel = 0, LayoutOrder = ord(page) }, page)
        mk("UICorner", { CornerRadius = CORNER }, holder)
        local lab = mk("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 4),
            Size = UDim2.new(1, -20, 0, 16), TextColor3 = Color3.fromRGB(230, 230, 235), Font = Enum.Font.Gotham,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left }, holder)
        local barBg = mk("Frame", { Position = UDim2.new(0, 10, 0, 28), Size = UDim2.new(1, -20, 0, 6),
            BackgroundColor3 = Color3.fromRGB(50, 50, 60), BorderSizePixel = 0 }, holder)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, barBg)
        local fill = mk("Frame", { Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(0, 200, 90), BorderSizePixel = 0 }, barBg)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

        paint = function()
            local rel = math.clamp((val - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            lab.Text = string.format("%s: " .. fmt, label, val)
        end
        paint()

        local dragging = false
        holder.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
        end)
        hook(UIS.InputEnded, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
                dragging = false
                if onRelease then onRelease(val) end
            end
        end)
        hook(RunService.RenderStepped, function()
            if not dragging then return end
            local rel = math.clamp((LP:GetMouse().X - barBg.AbsolutePosition.X)
                / math.max(barBg.AbsoluteSize.X, 1), 0, 1)
            val = min + (max - min) * rel
            if paint then paint() end
            if onChange then onChange(val) end
        end)
    end)
    if not ok then buildErr("slider:" .. tostring(label), err) end

    local obj = {}
    function obj:set(v, fire)
        val = math.clamp(v, min, max)
        if paint then paint() end
        if fire and onChange then onChange(val) end
        if fire and onRelease then onRelease(val) end
    end
    function obj:get() return val end
    sliderByLabel[label] = obj
    return obj
end

local CFG_FILE = "ml_config.json"

local function saveCfg(silent)
    if not writefile then
        if not silent then print("[ML] このexecutorはwritefile非対応") end
        return
    end
    local L = {}
    for label, o in pairs(sliderByLabel) do
        pcall(function() L[label] = o:get() end)
    end
    local ok, err = pcall(function()
        local json = game:GetService("HttpService"):JSONEncode({ T = T, S = S, L = L })
        writefile(CFG_FILE, json)
    end)
    if not silent then
        print(ok and ("[ML] 設定保存: " .. CFG_FILE) or ("[ML] 保存失敗: " .. tostring(err)))
    end
end

local function loadCfg(silent)
    if not readfile then
        if not silent then print("[ML] このexecutorはreadfile非対応") end
        return false
    end
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(CFG_FILE))
    end)
    if not ok or type(data) ~= "table" then
        if not silent then print("[ML] 設定ファイルなし/不正 (" .. CFG_FILE .. ")") end
        return false
    end
    if type(data.S) == "table" then for k, v in pairs(data.S) do S[k] = v end end
    if type(data.L) == "table" then
        for label, v in pairs(data.L) do
            local o = sliderByLabel[label]
            if o then pcall(function() o:set(tonumber(v) or o:get(), false) end) end
        end
    end
    if type(data.T) == "table" then
        for k, v in pairs(data.T) do
            local o = togglesByKey[k]
            if o then pcall(function() o:set(v, true) end) else T[k] = v end
        end
    end
    if not silent then print("[ML] 設定読込: " .. CFG_FILE) end
    return true
end

