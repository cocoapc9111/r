        refreshPrompts()
        promptScanT = os.clock()
    end
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    for _, p in ipairs(promptCache) do
        if p.Parent and p.Enabled
            and (not promptCooldown[p] or os.clock() >= promptCooldown[p]) then
            local pos = promptPos(p)
            if pos and (pos - myHrp.Position).Magnitude <= S.PromptRange then
                local hold = p.HoldDuration or 0
                promptCooldown[p] = os.clock() + hold + 1.5
                task.spawn(function()
                    pcall(function() p:InputHoldBegin() end)
                    task.wait(hold + 0.1)
                    pcall(function() p:InputHoldEnd() end)
                end)
            end
        end
    end
end

