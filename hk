    elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not gp and T.ClickTP then
        local m = LP:GetMouse()
        local hit = m.Hit
        if hit then teleport(hit.X, hit.Y + 3, hit.Z) end
    end
