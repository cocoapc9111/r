local auraTargetHrp = nil

local function frameBody()
    if dragging and dragOffset and win.Parent then
        local m = LP:GetMouse()
        win.Position = UDim2.fromOffset(m.X + dragOffset.X, m.Y + dragOffset.Y)
    end

    if T.InfJump and UIS:IsKeyDown(Enum.KeyCode.Space) then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end) end
    end

    if T.KillAura and T.FaceTarget and auraTargetHrp and auraTargetHrp.Parent then
        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if myHrp then
            local a, b = myHrp.Position, auraTargetHrp.Position
            if (Vector3.new(b.X, 0, b.Z) - Vector3.new(a.X, 0, a.Z)).Magnitude > 0.5 then
                myHrp.CFrame = CFrame.new(a, Vector3.new(b.X, a.Y, b.Z))
            end
        end
    end

    if T.Fly and flyBV and flyBG and flyBV.Parent and flyBG.Parent then
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if keys.W then dir += cam.CFrame.LookVector end
        if keys.S then dir -= cam.CFrame.LookVector end
        if keys.D then dir += cam.CFrame.RightVector end
        if keys.A then dir -= cam.CFrame.RightVector end
        if keys.Space then dir += Vector3.yAxis end
        if keys.LShift then dir -= Vector3.yAxis end
        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.FlySpeed or Vector3.zero
        flyBG.CFrame = cam.CFrame
        local ch = LP.Character
        if ch then
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end

