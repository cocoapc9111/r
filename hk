local espCache = {}
_G.ML_EspCache = espCache

local function getEsp(plr)
    local e = espCache[plr]
    if not e and hasDrawing then
        e = {}
        e.box = Drawing.new("Square")
        e.box.Thickness, e.box.Filled, e.box.Visible = 1, false, false
        e.box.Color = Color3.fromRGB(0, 255, 110)
        e.name = Drawing.new("Text")
        e.name.Size, e.name.Center, e.name.Outline, e.name.Visible = 14, true, true, false
        e.name.Color = Color3.new(1, 1, 1)
        espCache[plr] = e
    end
    return e
end

hook(RunService.RenderStepped, function()
    if not T.ESP or not hasDrawing then
        for _, e in pairs(espCache) do
            pcall(function() e.box.Visible = false end)
            pcall(function() e.name.Visible = false end)
        end
        return
    end
    local cam = workspace.CurrentCamera
    for _, pl in ipairs(Players:GetPlayers()) do
        local e = getEsp(pl)
        local ch = pl.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if pl ~= LP and hum and hum.Health > 0 and hrp then
            local okB, cf, size = pcall(function() return ch:GetBoundingBox() end)
            if okB and cf then
                local topV, on = cam:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y / 2, 0))
                local botV       = cam:WorldToViewportPoint(cf.Position - Vector3.new(0, size.Y / 2, 0))
                local h = botV.Y - topV.Y
                if on and h > 6 and topV.Z > 0 then
                    local w = h * (size.X / size.Y)
                    local cx = (topV.X + botV.X) / 2
                    e.box.Size = Vector2.new(w, h)
                    e.box.Position = Vector2.new(cx - w / 2, topV.Y)
                    e.box.Visible = true
                    e.name.Text = string.format("%s [%d]", pl.Name, math.floor(hum.Health))
                    e.name.Position = Vector2.new(cx, topV.Y - 17)
                    e.name.Visible = true
                else
                    e.box.Visible, e.name.Visible = false, false
                end
            else
                e.box.Visible, e.name.Visible = false, false
            end
        else
            e.box.Visible, e.name.Visible = false, false
        end
    end
end)

