        elseif kc == Enum.KeyCode.A then keys.A = true
        elseif kc == Enum.KeyCode.S then keys.S = true
        elseif kc == Enum.KeyCode.D then keys.D = true
        elseif kc == Enum.KeyCode.Space then keys.Space = true
        elseif kc == Enum.KeyCode.LeftShift then keys.LShift = true
        elseif kc == Enum.KeyCode.RightControl and not gp then
            gui.Enabled = not gui.Enabled
        elseif kc == Enum.KeyCode.B and not gp and flyToggle then
            flyToggle:set(not T.Fly, true)
        elseif kc == Enum.KeyCode.H and not gp and togglesByKey.HUD then
            togglesByKey.HUD:set(not T.HUD, true)
        elseif kc == Enum.KeyCode.End and not gp then
            print("[ML] 全停止 (End)")
