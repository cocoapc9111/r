function UI.toggle(page, key, label, default, onChange)
    T[key] = default or false
    local state = T[key]
    local obj = {}
    function obj:set(v, fire)
        state, T[key] = v, v
        if fire and onChange then onChange(v) end
    end
    local ok, err = pcall(function()
        local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(30, 30, 38),
            Text = "", AutoButtonColor = false, LayoutOrder = ord(page) }, page)
        mk("UICorner", { CornerRadius = CORNER }, btn)
        mk("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -56, 1, 0),
            Position = UDim2.new(0, 10, 0, 0), Text = label, TextColor3 = Color3.fromRGB(230, 230, 235),
            Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, btn)
        local pill = mk("Frame", { Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -46, 0.5, -9),
            BackgroundColor3 = Color3.fromRGB(60, 60, 70), BorderSizePixel = 0 }, btn)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
        local dot = mk("Frame", { Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = Color3.fromRGB(230, 230, 235),
            BorderSizePixel = 0 }, pill)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)

        function obj:set(v, fire)
            state, T[key] = v, v
            pill.BackgroundColor3 = v and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(60, 60, 70)
            dot.Position = v and UDim2.new(0, 20, 0, 2) or UDim2.new(0, 2, 0, 2)
            if fire and onChange then onChange(v) end
        end
        obj:set(state, false)
        btn.MouseButton1Click:Connect(function() obj:set(not state, true) end)
    end)
    if not ok then buildErr("toggle:" .. tostring(label), err) end
    togglesByKey[key] = obj
    return obj
end

