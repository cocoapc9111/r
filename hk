local ATTACK_KEYWORDS = { "punch", "attack", "damage", "hit", "combat", "strike", "hurt" }
local ARG_TRIALS = {
    { "punch" }, { "attack" }, { "hit" }, { "damage" }, { "combat" }, {},
}
local ATK = {
    cands = {}, idx = 1, argsIdx = 1,
    locked = false, probing = false, deadline = 0,
    baseHP = nil, hum = nil, remote = nil, args = nil,
}

local function kwPriority(rem)
    local ln = rem.Name:lower()
    for i, kw in ipairs(ATTACK_KEYWORDS) do
        if ln:find(kw, 1, true) then return i end
    end
    return 99
end

local function fireRemote(rem, args)
    if rem:IsA("RemoteFunction") then rem:InvokeServer(table.unpack(args))
    else rem:FireServer(table.unpack(args)) end
end

local function scanCombat()
    ATK.cands = {}
    local function scan(parent)
        if not parent then return end
        for _, v in ipairs(parent:GetChildren()) do
            if kwPriority(v) < 99 then ATK.cands[#ATK.cands + 1] = v end
        end
    end
    scan(rEvents)
    scan(LP)
    table.sort(ATK.cands, function(a, b) return kwPriority(a) < kwPriority(b) end)
    ATK.idx, ATK.argsIdx, ATK.probing, ATK.locked = 1, 1, false, false
    if ATTACK.remoteName ~= "" then
        local rem = (rEvents and rEvents:FindFirstChild(ATTACK.remoteName)) or LP:FindFirstChild(ATTACK.remoteName)
        if rem then ATK.remote, ATK.args, ATK.locked = rem, ATTACK.args, true end
    end
    local names = {}
    for _, v in ipairs(ATK.cands) do names[#names + 1] = v.Name .. ":" .. v.ClassName end
    print("[ML] 攻撃候補 = " .. (#names > 0 and table.concat(names, ", ") or "なし"))
end

local function remoteAttack(target, hum)
    if #ATK.cands == 0 then return end
    if ATK.locked then pcall(fireRemote, ATK.remote, ATK.args) return end
    local now = os.clock()
    if ATK.probing then
        if now < ATK.deadline then return end
        local hpNow = (ATK.hum and ATK.hum.Parent) and ATK.hum.Health or nil
        local success = (hpNow == nil) or (ATK.baseHP and hpNow < ATK.baseHP)
        if success then
            ATK.locked = true
            print("[ML] 攻撃ロック: " .. ATK.remote.Name .. " / " .. table.concat(ATK.args, ", "))
            return
        end
        ATK.argsIdx = ATK.argsIdx + 1
        if ATK.argsIdx > #ARG_TRIALS then
            ATK.argsIdx = 1
            ATK.idx = ATK.idx + 1
            if ATK.idx > #ATK.cands then
                ATK.idx, ATK.argsIdx, ATK.locked = 1, 1, true
                ATK.remote, ATK.args = ATK.cands[1], ARG_TRIALS[1]
                print("[ML] 攻撃: 検証失敗 → 先頭候補を採用 (" .. ATK.cands[1].Name .. ")")
                return
            end
        end
        ATK.probing = false
    end
    local rem = ATK.cands[ATK.idx]
    if not rem then return end
    ATK.remote, ATK.args = rem, ARG_TRIALS[ATK.argsIdx]
    pcall(fireRemote, rem, ARG_TRIALS[ATK.argsIdx])
    ATK.hum, ATK.baseHP = hum, hum and hum.Health
    ATK.probing = true
    ATK.deadline = now + 0.7
end

local function scanTrainRemotes()
    local out = {}
    local function scan(parent)
        if not parent then return end
        for _, v in ipairs(parent:GetChildren()) do
            local ln = v.Name:lower()
            for _, h in ipairs(TRAIN_REMOTE_HINTS) do
                if ln:find(h, 1, true) then
                    out[#out + 1] = v.Name .. ":" .. v.ClassName
                    break
                end
            end
        end
    end
    scan(rEvents)
    scan(LP)
    scan(RS)
    return out
end

