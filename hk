local lastErr, lastErrT = "", 0
local function reportErr(err)
    local m = tostring(err)
    if m ~= lastErr or os.clock() - lastErrT > 5 then
        print("[ML] エラー(継続): " .. m)
        lastErr, lastErrT = m, os.clock()
    end
end

local conns = {}
local function hook(signal, fn)
    local c = signal:Connect(function(...)
        if not alive() then return end
        local ok, err = pcall(fn, ...)
        if not ok then reportErr(err) end
    end)
    conns[#conns + 1] = c
    return c
end

local function loop(secFn, body)
    task.spawn(function()
        while alive() do
            local ok, err = pcall(function()
                task.wait(secFn())
                body()
            end)
            if not ok then reportErr(err) end
        end
    end)
end

