    if not inRange and best and bestD < 3000 then
        teleport(best.X, best.Y + 3, best.Z)
    end
end)

local rebirthWarnT, rebirthNextTry, rebirthPrintT = 0, 0, 0

local function rebirthNow(force)
    resolveRemotes()
    local now = os.clock()
    if not force and now < rebirthNextTry then
        if now - rebirthPrintT > 5 then
            print(string.format("[ML] 転生: バックオフ中 (あと%.0f秒)", rebirthNextTry - now))
            rebirthPrintT = now
        end
        return
    end
    if not rebirthR then
        if now - rebirthPrintT > 15 then
            print("[ML] 転生: rebirthRemote 未解決 (rEvents=" .. tostring(rEvents ~= nil) .. ")")
            rebirthPrintT = now
        end
        rebirthNextTry = now + 15
        return
    end
    
    local rb = rebirthCount()
    local st = strengthStat()
    local need = (rb ~= nil and st) and rebirthNeed(rb) or nil
    if not force and need and st and typeof(st.Value) == "number" and st.Value < need then
        if now - rebirthPrintT > 10 then
            print(string.format("[ML] 転生待ち: %s %s / 必要 %s (次の転生 #%d)",
                st.Name, fmtNum(st.Value), fmtNum(need), rb + 1))
            rebirthPrintT = now
        end
        rebirthNextTry = now + 5
        return
    end
    local ch, bp = LP.Character, LP:FindFirstChild("Backpack")
    if ch and bp then
        for _, v in ipairs(ch:GetChildren()) do
            if v:IsA("Tool") then v.Parent = bp end
        end
    end
    local ok, ret = pcall(function()
        if rebirthR:IsA("RemoteFunction") then return rebirthR:InvokeServer("rebirthRequest") end
        rebirthR:FireServer("rebirthRequest")
        return nil
    end)
    local success = ok and ret ~= false
    rebirthNextTry = os.clock() + (success and 10 or S.RebirthBackoff)
    print(string.format("[ML] 転生: ok=%s ret=%s%s%s → 次の再試行 %d秒後",
        tostring(ok), tostring(ret),
        need and (" (必要 " .. fmtNum(need) .. ")") or "",
        force and " [手動]" or "",
        success and 10 or S.RebirthBackoff))
end

local targetMode = 3  

local function toolAttack()
    local ch, bp = LP.Character, LP:FindFirstChild("Backpack")
    if not ch then return end
    local tool = nil
    for _, v in ipairs(ch:GetChildren()) do
        if v:IsA("Tool") and isKillMove(v.Name) then tool = v break end
    end
    if not tool and bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") and isKillMove(v.Name) then v.Parent = ch tool = v break end
        end
    end
    if tool then tool:Activate() end
end

local function nearestTarget(maxDist)
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local cands = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and not (pl.Team and LP.Team and pl.Team == LP.Team) then
            local ch = pl.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local d = (hrp.Position - myHrp.Position).Magnitude
                if d <= maxDist then
                    cands[#cands + 1] = { pl = pl, d = d, s = strengthOf(pl) }
                end
            end
        end
    end
    if #cands == 0 then return nil end
    if targetMode == 1 then
        table.sort(cands, function(a, b)
            local av = (a.s ~= nil) and a.s or math.huge
            local bv = (b.s ~= nil) and b.s or math.huge
            return av < bv
        end)
    elseif targetMode == 2 then
        table.sort(cands, function(a, b)
            local av = (a.s ~= nil) and a.s or -1
            local bv = (b.s ~= nil) and b.s or -1
            return av > bv
        end)
    else
        table.sort(cands, function(a, b) return a.d < b.d end)
    end
    return cands[1].pl, cands[1].d
end

