local function serverHop()
    print("[ML] サーバーリスト取得中...")
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"
    local body
    local ok = pcall(function() body = game:HttpGet(url) end)
    if not ok or not body then
        ok = pcall(function()
            local r = http_request({ Url = url, Method = "GET" })
            body = r and r.Body
        end)
    end
    if not ok or not body then print("[ML] リスト取得失敗 (HttpGet拒否)") return end
    local ok2, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(body)
    end)
    if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then
        print("[ML] リスト解析失敗")
        return
    end
    local cands = {}
    for _, s in ipairs(data.data) do
        if s.id and s.id ~= game.JobId and tonumber(s.playing) and tonumber(s.maxPlayers)
            and tonumber(s.playing) < tonumber(s.maxPlayers) then
            cands[#cands + 1] = s.id
        end
    end
    if #cands == 0 then print("[ML] 空きサーバーなし") return end
    for _ = 1, math.min(3, #cands) do
        local id = cands[math.random(1, #cands)]
        local okT = pcall(function() Teleport:TeleportToPlaceInstance(game.PlaceId, id, LP) end)
        if okT then print("[ML] 移動: " .. id) return end
        task.wait(1)
    end
    print("[ML] 移動失敗 (3回試行)")
end

