local function collectTools(container, hinted, generic)
    for _, v in ipairs(container:GetChildren()) do
        if v:IsA("Tool") and not isKillMove(v.Name) then
            if isHinted(v.Name, TRAIN_HINTS) then hinted[#hinted + 1] = v
            else generic[#generic + 1] = v end
        end
    end
end

local function autoLiftTick()
    if os.clock() < consumeLock then return end
    resolveRemotes()
    local ch, bp = LP.Character, LP:FindFirstChild("Backpack")
    if not ch then return end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hinted, generic = {}, {}
    if bp then collectTools(bp, hinted, generic) end
    collectTools(ch, hinted, generic)
    local list = (#hinted > 0) and hinted or generic

    if #list == 0 then
        if T.LiftRemote then fireRep(S.RepPerTick) end
        return
    end

    if T.AllTools then
        for _, v in ipairs(list) do
            if v.Parent ~= ch then v.Parent = ch end
        end
        if T.LiftActivate then
            for _, v in ipairs(ch:GetChildren()) do
                if v:IsA("Tool") and not isKillMove(v.Name) then
                    pcall(function() v:Activate() end)
                end
            end
        end
    else
        table.sort(list, function(a, b) return toolWeight(a) > toolWeight(b) end)
        local chosen = list[((liftIdx - 1) % #list) + 1]
        for _, v in ipairs(ch:GetChildren()) do
            if v:IsA("Tool") and v ~= chosen and bp then v.Parent = bp end
        end
        if chosen.Parent ~= ch then chosen.Parent = ch end
        if T.LiftActivate then pcall(function() chosen:Activate() end) end
    end

    if T.LiftRemote then fireRep(S.RepPerTick) end
end

