loop(function() return 1 end, function()
    if hudGui then hudGui.Enabled = T.HUD end
    if not T.HUD then return end
    local lines = {}
    local st = strengthStat()
    if st and typeof(st.Value) == "number" then
        local now = os.clock()
        if hudLastV ~= nil and now > hudLastT then
            if st.Value >= hudLastV then
                local delta = st.Value - hudLastV
                sessionGain = sessionGain + delta
                local inst = delta / (now - hudLastT) * 60
                if inst <= 100000 then hudRate = hudRate * 0.7 + inst * 0.3 end
            else
                hudRate = 0
            end
        end
        hudLastV, hudLastT = st.Value, now
        lines[#lines + 1] = string.format("%s: %s  (+%s/分)", st.Name, fmtNum(st.Value), fmtNum(hudRate))
    else
        lines[#lines + 1] = "筋力: (leaderstatsなし)"
    end
    local el = os.clock() - sessionStart
    lines[#lines + 1] = string.format("セッション %d:%02d:%02d  総獲得 +%s",
        math.floor(el / 3600), math.floor(el / 60) % 60, math.floor(el) % 60, fmtNum(sessionGain))
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v ~= st and v:IsA("ValueBase") then
                local ok, val = pcall(function() return v.Value end)
                if ok then lines[#lines + 1] = v.Name .. ": " .. tostring(val) end
            end
        end
    end
    local eq = {}
    local ch = LP.Character
    if ch then
        for _, v in ipairs(ch:GetChildren()) do
            if v:IsA("Tool") and not isKillMove(v.Name) then eq[#eq + 1] = v.Name end
        end
    end
    lines[#lines + 1] = "装備: " .. (#eq > 0 and table.concat(eq, ", ") or "なし")
    lines[#lines + 1] = string.format("鍛え:%s 調速:%s 狙い:%s",
        T.AutoMuscle and "ON" or "OFF", T.AutoTune and "ON" or "OFF", TARGET_NAMES[targetMode])
    local hudRb = rebirthCount()
    if hudRb ~= nil then
        lines[#lines + 1] = string.format("転生: %d回 / 次の条件 %s",
            hudRb, fmtNum(rebirthNeed(hudRb)))
    end
    
    local rank = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        local v = strengthOf(pl)
        if v then rank[#rank + 1] = { n = pl.Name, v = v } end
    end
    table.sort(rank, function(a, b) return a.v > b.v end)
    local top = {}
    for i = 1, math.min(5, #rank) do
        top[#top + 1] = string.format("%d.%s(%s)", i, rank[i].n, shortNum(rank[i].v))
    end
    if #top > 0 then lines[#lines + 1] = "上位: " .. table.concat(top, " ") end
    
    if os.clock() - promptScanT > 3 then
        refreshPrompts()
        promptScanT = os.clock()
    end
    local myHrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if myHrp then
        local bestD = math.huge
        for _, pr in ipairs(promptCache) do
            if pr.Parent and pr.Enabled then
                local pos = promptPos(pr)
                if pos then
                    local d = (pos - myHrp.Position).Magnitude
                    if d < bestD then bestD = d end
                end
            end
        end
        lines[#lines + 1] = string.format("プレイヤー: %d人  最寄りprompt: %s",
            #Players:GetPlayers(), bestD == math.huge and "なし" or (fmtNum(bestD) .. "st"))
    end
    lines[#lines + 1] = string.format("未回収アイテム: %d / %d", itemLeft, itemTotal)
    hudText.Text = table.concat(lines, "\n")
end)

